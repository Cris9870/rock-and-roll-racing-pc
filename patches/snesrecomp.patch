 # ── Per-op handlers ─────────────────────────────────────────────────────────
 
+def _open_bus_operand_byte(seg) -> Optional[int]:
+    """The last instruction byte the CPU fetched before the data read, which
+    is what an unmapped address returns (open bus). Compiled code fetches no
+    instruction bytes, so without this the bus holds whatever an earlier
+    access left there. Indirect modes read their pointer through cpu_read*,
+    which already leaves the right byte on the bus."""
+    k = seg.kind
+    if k in (SegKind.DIRECT, SegKind.STACK):
+        return seg.offset & 0xFF
+    if k == SegKind.ABS_BANK:
+        return (seg.offset >> 8) & 0xFF
+    if k == SegKind.LONG:
+        return (seg.bank if seg.bank is not None else 0) & 0xFF
+    return None
+
+
 def _emit_read(op: Read) -> List[str]:
     bank, addr = _segref_addr_expr(op.seg)
-    return [f"{widths.ctype(op.width)} {_v(op.out)} = "
-            f"{widths.read_fn(op.width)}(cpu, {bank}, {addr});"]
+    lines = []
+    ob = _open_bus_operand_byte(op.seg)
+    if ob is not None:
+        # Rock N' Roll Racing's hero select does `LDA $5C00` with DB=$80
+        # (unmapped) and uses the open-bus $5C5C as a VRAM address.
+        lines.append(f"cpu->open_bus = {ob:#04x};")
+    lines.append(f"{widths.ctype(op.width)} {_v(op.out)} = "
+                 f"{widths.read_fn(op.width)}(cpu, {bank}, {addr});")
+    return lines
 
 
